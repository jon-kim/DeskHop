<Window x:Class="DeskHop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Screen Manager" Height="360" Width="600" MinHeight="320" MinWidth="600"
        PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel Margin="16">
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem HorizontalContentAlignment="Stretch">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusBarText" VerticalAlignment="Center" />
          <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Click="RefreshButton_Click" Grid.Column="1" Padding="3px" />
        </Grid>
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBlock Text="Open app windows" FontWeight="SemiBold" />

      <ComboBox x:Name="WindowSelector"
                Grid.Row="1"
                Margin="0,8,0,16"
                DisplayMemberPath="DisplayName"
                MinHeight="28"
                SelectionChanged="Selector_SelectionChanged" />

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Move to monitor" VerticalAlignment="Center" FontWeight="SemiBold" Grid.Column="0" />
        <ComboBox x:Name="MonitorSelector"
            Margin="12,0,0,0"
            DisplayMemberPath="DisplayName"
            SelectionChanged="Selector_SelectionChanged" 
            Grid.Column="1" />
        <Button x:Name="MoveButton"
          Content="Move"
          Margin="8,0,0,0"
          Click="MoveButton_Click"
          Grid.Column="2" />
      </Grid>
    </Grid>
  </DockPanel>
</Window>
